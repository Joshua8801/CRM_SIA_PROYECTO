# Variables de entorno para Docker Compose (PostgreSQL 17 y Backend)
# Copiar este archivo a .env en la raíz y definir la contraseña local.
POSTGRES_DB=crm_academico
POSTGRES_USER=crm_admin
POSTGRES_PASSWORD=TU_PASSWORD

# Origen permitido para CORS en el backend (opcional; por defecto http://localhost:5173)
CORS_ORIGIN=http://localhost:5173
