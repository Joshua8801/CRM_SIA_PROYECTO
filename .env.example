# Variables de entorno para Docker Compose (PostgreSQL 17, Backend y Frontend)
# Copiar este archivo a .env en la raíz y definir la contraseña local.
POSTGRES_DB=crm_academico
POSTGRES_USER=crm_admin
POSTGRES_PASSWORD=TU_PASSWORD

# Puertos del host (valores predeterminados; cambiar si están ocupados)
POSTGRES_PORT=5433
FRONTEND_PORT=5173

# Origen permitido para CORS en el backend (debe coincidir con FRONTEND_PORT)
CORS_ORIGIN=http://localhost:5173
