# Puerto del servidor Express
PORT=4000

# Conexión a PostgreSQL 17 (local o servidor universitario)
# Formato: postgresql://USUARIO:PASSWORD@HOST:PUERTO/BASE_DE_DATOS
DATABASE_URL=postgresql://crm_admin:TU_PASSWORD@localhost:5433/crm_academico

# Activar SSL si el servidor universitario lo requiere (true/false)
DB_SSL=false

# Secreto para firmar tokens JWT
JWT_SECRET=TU_PASSWORD
JWT_EXPIRES_IN=8h

# Origen permitido para CORS (URL del frontend)
CORS_ORIGIN=http://localhost:5173
